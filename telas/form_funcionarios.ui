     <string notr="true">QHeaderView::section {
	font-family: &quot;MS Shell Dlg 2&quot;;
    font-size: 16px;
    font-weight: bold;
    color: white;
    background-color: rgb(103, 43, 43);
    color: white;
    border: none;
	padding: 8px;
}
QHeaderView::section:first {
	border-top-left-radius: 20px;  /* Canto superior esquerdo */
    border-top-right-radius: 0px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}
QHeaderView::section:last {
	border-top-left-radius: 0px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}
QTableWidget {
    border: none;
    border-radius: 25px;
    background-color: white;
    /* Necessário para o fundo arredondar corretamente */
    padding: 1px;
}
QTableWidget::section:first {
	font-family: &quot;Times New Roman&quot;;
    font-size: 12px;
	font-weight: bold;
    color: black;
}
QTableWidget::section:second, third {
	font-family: &quot;Times New Roman&quot;;
    font-size: 10px;
    color: rgb(152, 152, 152);
	text-align: center;
}
QTableWidget::section:last {
	font-family: &quot;Times New Roman&quot;;
    font-size: 12px;
	font-weight: bold;
    color: black;
	text-align: center;
}</string>
